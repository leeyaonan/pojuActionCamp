# 应用
DEBUG=true
DATABASE_URL=sqlite:///./data/app.db

# 大模型
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-xxx
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT=60

# 破局接口（初始可空，运行时从 DB 读取覆盖；Token 不放此处，存 DB）
POJU_BASE_URL=

# 定时任务
SCHEDULER_ENABLED=true
SYNC_CRON_HOUR=9
SYNC_CRON_MINUTE=0

# 安全：Token 加密用密钥（生产环境请替换为随机字符串）
SECRET_KEY=change-me-to-random-string
